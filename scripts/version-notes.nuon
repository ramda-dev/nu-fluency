# Version notes for the nu-fluency skills: read by scripts/version-notes.nu.
#
# kind: option      behavior that depends on an experimental option. `option.enabled`
#                   is the setting the note warns about; the note applies only when
#                   the running nu has that option and it is set that way.
# kind: diagnostic  an unresolved Nushell bug. `since` is the oldest version that
#                   reproduces it (0.114.1 was the oldest checked), `reproduced` the
#                   newest, `until` the first fixed version once known (null: open).
#
# Prose is written for a skill reader: `symptom` says what goes wrong, `workaround`
# what to write instead. After editing, regenerate the reference table with
# `nu --no-config-file scripts/version-notes.nu render --write`. Some skills also
# state a workaround in their own prose; when a bug gets an `until`, search the
# skills for its workaround and update those lines too.
[
  {
    id: pipefail-off
    kind: option
    skills: [nushell-idioms nushell-control-flow]
    option: {name: pipefail enabled: false}
    symptom: 'an external that fails mid-pipeline (`^false | lines`) does not stop the pipeline or reach `catch`; only the last command decides the outcome (with it on, see also pipefail-skips-bound-pipelines)'
    workaround: 'capture the external with `complete` and test its `exit_code`'
    repro: 'try { ^false | lines | length; "no error" } catch { "error" }'
  }
  {
    id: runtime-annotations-off
    kind: option
    skills: [nushell-idioms]
    option: {name: enforce-runtime-annotations enabled: false}
    symptom: 'a `let` or `mut` annotation is still checked where the parser can prove a mismatch (`let x: int = "a"` fails), but every other check is a runtime check and is skipped, so a value of another type binds silently: an empty record for `record<x: int>`, a mixed list for `list<string>`, or a value from `from json`, `open`, an external or the pipeline form `… | let x: T`'
    workaround: 'check the type yourself with `describe` where it matters, or turn the option back on'
    repro: "let y: int = ('[1]' | from json); $y | describe"
  }
  {
    id: hide-env-after-env-call
    kind: diagnostic
    skills: [nushell-env-scoping nushell-idioms]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: '`hide-env` leaves a variable set when nu code assigned it in an outer block and a `do --env` or `def --env` call has already run in a nested block (the one running `hide-env`, or one enclosing it); calling `hide-env` from a `def --env` helper does not help'
    workaround: 'run `hide-env` before any `--env` call in that block and in every block enclosing it, or run externals that must not see the variable under `with-env {VAR: null}` or `env -i`'
    repro: '$env.FOO = 1; do { do --env { }; hide-env FOO; $env has FOO }'
    upstream: null
  }
  {
    id: try-escapes-under-ignore
    kind: diagnostic
    skills: [nushell-control-flow]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: "a `try` (with or without `catch`) that ends the body of a command or a `do` block does not catch when that output is piped to `ignore`: the error escapes"
    workaround: "bind the result (`let _ = f`), or end the command's body with `null`"
    repro: 'def f [] { try { error make {msg: inner} } catch { "caught" } }; f | ignore'
    upstream: null
  }
  {
    id: pipefail-skips-bound-pipelines
    kind: diagnostic
    skills: [nushell-idioms nushell-control-flow]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: 'even with `pipefail` on, an external that fails mid-pipeline does not raise when the pipeline is bound with `let`, used in a subexpression, or returned from a command; it raises only when the pipeline is a statement of its own'
    workaround: 'capture the external with `complete` and test its `exit_code`'
    repro: 'try { let n = ^false | lines | length; "no error" } catch { "error" }'
    upstream: null
  }
  {
    id: later-statement-in
    kind: diagnostic
    skills: [nushell-control-flow]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: "in an `if` or `match` that is not the first statement of a block, the condition sees the block's input but a body written as a block (an `if` branch, or a `match` arm in `{…}`) gets an empty `$in`"
    workaround: 'bind the input first (`let xs = $in`), or write `$in | if ($in | …) { … }`'
    repro: '[1 2] | do { let y = 3; if ($in | is-empty) { "e" } else { $in | length } }'
    upstream: null
  }
  {
    id: par-each-unordered-slower
    kind: diagnostic
    skills: [nushell-performance]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: 'unordered `par-each` runs slower than `par-each --keep-order` on the same input, and can be slower than plain `each`'
    workaround: 'pass `--keep-order` even when order does not matter'
    repro: 'let xs = 1..1741 | each { $in }; {unordered: (1..5 | each { timeit { $xs | par-each { $in * 2 } } } | math avg) ordered: (1..5 | each { timeit { $xs | par-each --keep-order { $in * 2 } } } | math avg)}'
    upstream: null
  }
  {
    id: bench-writes-escapes
    kind: diagnostic
    skills: [nushell-performance]
    since: '0.114.1'
    reproduced: '0.117.0'
    until: null
    symptom: "`std/bench` prints a terminal progress escape (OSC 9;4) to stdout even without `--progress`, so a script's captured output starts with it; a result for two or more closures also carries ANSI highlighting in its `code` column"
    workaround: "time with the probe kit's `probe time`, or with `timeit`"
    repro: 'use std/bench; bench { 1 } --rounds 5 | to nuon'
    upstream: null
  }
]
